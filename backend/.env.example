# VERILUMEN — environment variables (copy to .env, never commit .env)

# --- Application ---
ENVIRONMENT=development
APP_VERSION=1.0.0
JSON_LOGS=true
LOG_LEVEL=INFO
ENABLE_HSTS=false

# --- Database (required) ---
DATABASE_URL=postgresql+asyncpg://verilumen:CHANGE_ME@localhost:5432/verilumen

# --- Redis (required) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=verilumen:

# --- MinIO (required — rotate secrets in production) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_BUCKET_RAW=verilumen-raw-uploads
MINIO_BUCKET_PARSED=verilumen-parsed
MINIO_BUCKET_WAFER=verilumen-wafer-images
MINIO_BUCKET_EXPORTS=verilumen-exports
MINIO_BUCKET_AI=verilumen-ai-artifacts
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- JWT (required — MUST change in production) ---
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- API ---
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Worker / health ---
WORKER_HEARTBEAT_MAX_AGE_SEC=120

# --- Scan Chain pipeline / agents ---
PATTERN_AGENT_BASE_URL=http://127.0.0.1:8010
FAILURE_AGENT_API_URL=http://127.0.0.1:8020
FAILURE_AGENT_DASHBOARD_URL=http://127.0.0.1:3020/embed/failure/overview
SCAN_DIAGNOSIS_AGENT_API_URL=http://127.0.0.1:8030
SCAN_DIAGNOSIS_AGENT_DASHBOARD_URL=http://127.0.0.1:3030/embed/scan
VERILUMEN_SERVICE_KEY=dev-service-key-change-me
AGENT_OUTPUT_ROOT=C:\personal\agent and parser output
UPLOAD_INPUT_ROOT=C:\personal\input all file
PARSER_ENGINE_PATH=C:\personal\parser engine
AGENT_HTTP_TIMEOUT_SEC=120
AGENT_HTTP_RETRIES=3
MAX_UPLOAD_BYTES=10737418240

# --- Backups ---
BACKUP_DIR=backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
