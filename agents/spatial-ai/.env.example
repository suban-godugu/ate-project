# WaferVision-AI environment template
# Copy to `.env` and adjust for your environment.

WAFERVISION_ENV=development
WAFERVISION_VERSION=1.0.0
WAFERVISION_MODEL_VERSION=1.1.0

WAFERVISION_API_HOST=0.0.0.0
WAFERVISION_API_PORT=8000
WAFERVISION_API_WORKERS=1
WAFERVISION_REQUEST_TIMEOUT_SECONDS=300
WAFERVISION_MAX_UPLOAD_BYTES=20971520
WAFERVISION_MAX_BATCH_FILES=100

WAFERVISION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WAFERVISION_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.bmp

WAFERVISION_MODEL_PATH=models/resnet50_layer4_ft.pth
WAFERVISION_INPUT_ROOT=C:\personal\input all file
WAFERVISION_OUTPUT_ROOT=C:\personal\agent and parser output
WAFERVISION_LOGS_DIR=C:\personal\agent and parser output\wafer\logs
WAFERVISION_TEMP_DIR=C:\personal\input all file\wafer_uploads
WAFERVISION_VISUALIZATIONS_DIR=C:\personal\agent and parser output\wafer\visualizations
WAFERVISION_LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
WAFERVISION_FRONTEND_PORT=3000
