# Failure Analysis Agent — environment configuration
# Copy to .env and set DATABASE_PASSWORD to your PostgreSQL password.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=failure_analysis_db
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# Optional dataset root (semicolon-separated for EVALUATION_DATA_ROOTS)
# DATASET_ROOT=
# EVALUATION_DATA_ROOTS=

# Optional: override the URL built from the fields above.
# Must use the asyncpg driver. Do not use sqlite.
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/failure_analysis_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false

# Auth / JWT (production: set AUTH_REQUIRED=true and a strong JWT_SECRET)
JWT_SECRET=dev-only-change-me-jwt-secret-32b!
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_ADMIN_EMAIL=admin@verilumen.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
